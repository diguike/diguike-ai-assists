    "enter": {"text": "type", "hand": "type", "title": "fade", "box": "fade", "chip": "pop", "img": "fade",
              "stat": "count", "card": "fade", "step": "fade", "quote": "fade"},
    "ease": "cubicOut", "speed": 1.0, "type_cps": 15, "trans": "fade", "trans_dur": 0.35, "cam_dur": 1.0
  },
  "snappy": {
